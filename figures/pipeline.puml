@startuml component_diagram_final
skinparam componentStyle rectangle
skinparam backgroundColor #FFFFFF
title Архитектура пайплайна дообучения и оценки модели (функциональное разделение)

package "Среда выполнения: Google Colab Runtime" {
  package "1. Сбор и подготовка данных (Офлайн-контур)" {
    component "Клиент API Freesound" as fs_client
    component "Генератор миксов" as mixer
    component "Разделитель выборок\n(стратифицированный 80/10/10)" as splitter
    component "Модуль публикации в HuggingFace" as hf_pub
  }

  package "2. Модель и обучение (Рантайм-контур)" {
    component "Загрузчик данных\n(DataLoader)" as loader
    component "Модуль спектрального преобразования\n(STFT на лету)" as stft
    component "Базовая архитектура Open-Unmix\n(замороженные веса)" as base_model
    component "Адаптеры LoRA\n(матрицы lora_A, lora_B)" as lora
    component "Выходной слой разделения\n(4 × freq_bins)" as out_proj
    component "Цикл оптимизации\n(AdamW + L1 Loss)" as trainer
  }

  package "3. Модуль оценки" {
    component "Модуль обратного преобразования\n(iSTFT)" as istft
    component "Калькулятор метрик качества\n(SDR/SIR/SAR)" as metrics
    component "Модель-эталон для сравнения\n(htdemucs_6s)" as baseline
  }

  artifact "Интерфейс Jupyter Notebook" as ui
  artifact "Аппаратный ускоритель GPU" as gpu
  folder "Временное хранилище /content" as storage
}

node "Внешние облачные сервисы" {
  database "Freesound API v2" as fs_cloud
  database "HuggingFace Hub\n(репозиторий датасета, Parquet)" as hf_cloud
}

ui --> mixer : Запуск скрипта генерации
fs_cloud --> storage : Загрузка исходных .wav/.mp3
storage --> mixer : Чтение, ресемплинг, нормализация
mixer --> splitter : Синтезированные миксы
splitter --> hf_pub : Размеченные выборки (в памяти)
hf_pub --> hf_cloud : Прямая сериализация и публикация (push_to_hub)

hf_cloud --> loader : Потоковая загрузка батчей
loader --> stft : Аудио-массивы [T]
stft --> trainer : Тензоры спектрограмм [2, F, T]

gpu <-- trainer : Аппаратное ускорение
trainer --> base_model : Прямой проход (веса заморожены)
base_model --> lora : Передача скрытых представлений
lora --> out_proj : Адаптированные признаки
out_proj --> trainer : Маски источников [B, 2, 2, F, T]
trainer --> storage : Сохранение лучшей контрольной точки (.pt)
ui --> trainer : Управление процессом, логирование

trainer --> istft : Предсказанные спектрограммы (тест)
istft --> metrics : Восстановленные аудиосигналы
hf_cloud --> baseline : Загрузка тестовых миксов для сравнения
baseline --> metrics : Результаты инференса бейзлайна
metrics --> ui : Формирование итогового отчёта и графиков

@enduml





