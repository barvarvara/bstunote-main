@startuml
' !theme plain
' skinparam linetype ortho
skinparam componentStyle uml2
skinparam backgroundColor #F8F9FA

package "🌐 Внешние источники" {
  [Freesound API] as FS
  [HuggingFace Hub] as HF
}

package "📊 1. Сбор и подготовка данных" {
  component "FreesoundDataCollector" as Collector
  component "AudioMixer" as Mixer
  component "HF_MSSDataset\n(спектральный домен)" as SpectralDS
  component "AudioWrapperDataset\n(временной домен)" as WaveformDS
  component "SpecAugmentDataset\n(обёртка-аугментация)" as AugDS
  
  FS --> Collector
  Collector --> Mixer : <<data>> .wav файлы
  Mixer --> SpectralDS : <<split>> Dict[str, List]
  Mixer --> WaveformDS : <<split>> Dict[str, List]
  SpectralDS --> AugDS : <<decorator>> on-the-fly маски
}

package "🧠 2. Адаптация моделей" {
  interface "BaseSeparator" as IBase
  component "OpenUnmixAdapter\n(Full Fine-Tune)" as UnmixFT
  component "OpenUnmixAdapter\n(+ SpecAugment)" as UnmixAug
  component "DemucsAdapter\n(LoRA + FP16 + Subset)" as DemucsLora
  component "BaselineRunner\n(htdemucs_6s / Spleeter)" as Baseline

  IBase <|.. UnmixFT : implements
  IBase <|.. UnmixAug : implements
  IBase <|.. DemucsLora : implements
  IBase <|.. Baseline : implements
  
  SpectralDS --> UnmixFT : <<train>> [2, F, T]
  AugDS --> UnmixAug : <<train>> [2, F, T] (augmented)
  WaveformDS --> DemucsLora : <<train>> [2, T]
}

package "🔍 3. Оценка и публикация" {
  component "UnifiedEvaluator" as Eval
  component "HuggingFaceManager" as Pub
  
  UnmixFT --> Eval : <<eval>> predict()
  UnmixAug --> Eval : <<eval>> predict()
  DemucsLora --> Eval : <<eval>> predict()
  Baseline --> Eval : <<eval>> predict()
  
  Eval --> Pub : <<metrics>> JSON + ckpt
  Pub --> HF : <<upload>> model/dataset
}

note right of Eval
  Автоматически определяет домен:
  • spectrogram → ISTFTDecoder + bss_eval
  • waveform → прямой тензор + bss_eval
  Замеряет время инференса
end note

note bottom of DemucsLora
  Замена рекуррентного блока на 
  LoRA-адаптацию всех nn.Linear.
  FP16 + 30% подвыборка + 10 эпох
end note

note bottom of UnmixFT
  Полный файн-тюн 2 независимых копий.
  Сохранение предобученных весов.
  Без расширения fc3 (архитектурный конфликт)
end note
@enduml


